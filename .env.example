# Database
Database__ConnectionString=Host=localhost;Port=5432;Database=gamediscoveries;Username=gamediscoveries;Password=CHANGE_ME
Database__ApplyMigrationsOnStartup=true

# Redis
Redis__ConnectionString=localhost:6379
Redis__InstanceName=gamediscoveries:
Redis__Enabled=true

# Meilisearch
Meilisearch__Url=http://localhost:7700
Meilisearch__ApiKey=
Meilisearch__Enabled=true

# GameMonetize
GameMonetize__Enabled=false
GameMonetize__FeedUrl=
GameMonetize__ApiKey=

# Authentication (JWT / OAuth / OIDC)
Authentication__Enabled=false
Authentication__Authority=
Authentication__Audience=gamediscoveries-api
Authentication__RequireHttpsMetadata=true

# CORS
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://gamediscoveries.com

# OpenTelemetry
OpenTelemetry__Enabled=true
OpenTelemetry__ServiceName=GameDiscoveries.Api
OpenTelemetry__OtlpEndpoint=
OpenTelemetry__PrometheusEnabled=true

# Rate limiting
RateLimiting__PublicPermitLimit=60
RateLimiting__SearchPermitLimit=30
RateLimiting__AuthenticationPermitLimit=10
RateLimiting__AnalyticsPermitLimit=120
RateLimiting__WindowSeconds=60

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
