{
  "Cors": {
    "AllowedOrigins": [
      "https://gamediscoveries.com",
      "https://www.gamediscoveries.com"
    ]
  },
  "Authentication": {
    "Enabled": true,
    "Authority": "",
    "Issuer": "gamediscoveries-api",
    "Audience": "gamediscoveries-api",
    "AccessTokenMinutes": 120,
    "RequireHttpsMetadata": false
  },
  "OpenTelemetry": {
    "Enabled": true,
    "PrometheusEnabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
