{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=gamediscoveries;Username=gamediscoveries;Password=gamediscoveries",
    "ApplyMigrationsOnStartup": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gamediscoveries-dev:",
    "Enabled": true
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": "",
    "Enabled": true
  },
  "GameMonetize": {
    "Enabled": false,
    "FeedUrl": "https://gamemonetize.com/feed.php?format=0",
    "ApiKey": ""
  },
  "Authentication": {
    "Enabled": false,
    "Authority": "https://auth.gamediscoveries.com",
    "Audience": "gamediscoveries-api",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GameDiscoveries.Api",
    "OtlpEndpoint": "",
    "PrometheusEnabled": true
  },
  "RateLimiting": {
    "PublicPermitLimit": 120,
    "SearchPermitLimit": 60,
    "AuthenticationPermitLimit": 30,
    "AnalyticsPermitLimit": 300,
    "WindowSeconds": 60
  }
}
