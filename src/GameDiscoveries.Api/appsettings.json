{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=gamediscoveries;Username=gamediscoveries;Password=gamediscoveries",
    "ApplyMigrationsOnStartup": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gamediscoveries:",
    "Enabled": true
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": "",
    "Enabled": true
  },
  "GameMonetize": {
    "Enabled": false,
    "BaseUrl": "https://gamemonetize.com",
    "FeedUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "Feeds": {
      "Latest": "",
      "Popular": "",
      "Action": "",
      "Puzzle": "",
      "Racing": "",
      "Sports": "",
      "Multiplayer": "",
      "Mobile": "",
      "TwoPlayer": "",
      "Featured": "",
      "HotGames": "",
      "BestGames": "",
      "MostPlayed": "",
      "ExclusiveGames": ""
    }
  },
  "GameFeedSync": {
    "Enabled": false,
    "AdminApiKey": "",
    "LatestIntervalMinutes": 60,
    "PopularIntervalMinutes": 120,
    "CategoryIntervalMinutes": 360,
    "MobileIntervalMinutes": 360,
    "TwoPlayerIntervalMinutes": 360,
    "FeaturedIntervalMinutes": 360,
    "PopularityIntervalMinutes": 180,
    "StartupDelaySeconds": 20
  },
  "Authentication": {
    "Enabled": true,
    "Authority": "",
    "Issuer": "gamediscoveries-api",
    "Audience": "gamediscoveries-api",
    "SigningKey": "LOCAL_DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+",
    "AccessTokenMinutes": 120,
    "RequireHttpsMetadata": false,
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedDisplayName": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GameDiscoveries.Api",
    "OtlpEndpoint": "",
    "PrometheusEnabled": true
  },
  "RateLimiting": {
    "PublicPermitLimit": 600,
    "SearchPermitLimit": 120,
    "AuthenticationPermitLimit": 30,
    "AnalyticsPermitLimit": 300,
    "WindowSeconds": 60
  },
  "Community": {
    "TitleMaxLength": 160,
    "ContentMaxLength": 4000,
    "CommentMaxLength": 1500,
    "PostsPerWindow": 5,
    "PostWindowMinutes": 10,
    "RequirePlayedForReview": false
  },
  "Recommendation": {
    "AlgorithmVersion": "PERSONALIZED_V1",
    "DefaultLimit": 20,
    "CandidateLimit": 200,
    "MaxSameCategoryInTop10": 4,
    "ExplorationRatio": 0.10,
    "MmrLambda": 0.80,
    "ColdStartThreshold": 3,
    "Weights": {
      "Content": 0.25,
      "Preference": 0.20,
      "Behavior": 0.20,
      "Popularity": 0.10,
      "Freshness": 0.10,
      "Engagement": 0.05,
      "Exploration": 0.05,
      "Diversity": 0.05
    },
    "ColdStart": {
      "Trending": 0.40,
      "Popular": 0.30,
      "NewDiscoveries": 0.20,
      "Exploration": 0.10
    },
    "CacheTtl": {
      "ForYouSeconds": 600,
      "BecauseYouPlayedSeconds": 600,
      "SimilarSeconds": 1800,
      "TrendingSeconds": 420,
      "NewDiscoveriesSeconds": 1200,
      "HiddenGemsSeconds": 900
    },
    "Exclusion": {
      "ExcludePlayedForYou": true,
      "ExcludeFavoritedForYou": false,
      "ExcludePlayedBecauseYouPlayed": true,
      "ExcludeFavoritedBecauseYouPlayed": false
    }
  },
  "Leaderboard": {
    "Enabled": true,
    "Version": "LEADERBOARD_V1",
    "Timezone": "Asia/Jakarta",
    "IncludeAdminAdjustmentInLeaderboard": false,
    "TopMaxLimit": 100,
    "DefaultLimit": 50,
    "TopCacheSeconds": 60,
    "UserRankCacheSeconds": 45,
    "ReconciliationIntervalMinutes": 60,
    "SnapshotIntervalMinutes": 10,
    "PeriodRotationIntervalMinutes": 5,
    "CreditPrimaryGenreOnly": true
  },
  "Analytics": {
    "Enabled": true,
    "MaxBatchSize": 100,
    "MaxMetadataSizeKb": 16,
    "EnableAnonymousTracking": true,
    "ValidateGameExists": true,
    "IpHashSalt": "gamediscoveries-analytics"
  },
  "GameSession": {
    "Enabled": true,
    "HeartbeatIntervalSeconds": 30,
    "HeartbeatTimeoutSeconds": 90,
    "MinimumValidActiveSeconds": 30,
    "MaximumSessionDurationSeconds": 14400,
    "AllowMultipleGames": true,
    "AllowMultipleSameGameSessions": false,
    "HeartbeatAnalyticsSampleSeconds": 120,
    "MaxHeartbeatCreditSeconds": 60
  },
  "Xp": {
    "Enabled": true,
    "DailyXpCap": 500,
    "ValidGameSessionXp": 10,
    "FirstGameDiscoveryXp": 20,
    "NewGameXp": 15,
    "NewGenreXp": 20,
    "FavoriteXp": 10,
    "RatingXp": 10,
    "ReviewXp": 30,
    "SessionMilestone2MinutesXp": 10,
    "SessionMilestone5MinutesXp": 20,
    "SessionMilestone10MinutesXp": 30,
    "DailyMissionXp": 50,
    "WeeklyChallengeXp": 150,
    "QualifiedReferralXp": 100
  },
  "Missions": {
    "Enabled": true,
    "TimeZone": "Asia/Jakarta",
    "DailyMissionCount": 3,
    "WeeklyChallengeCount": 2,
    "NewUserXpThreshold": 100
  },
  "Streak": {
    "Enabled": true,
    "TimeZone": "Asia/Jakarta",
    "MinimumActiveSeconds": 30,
    "Freeze": {
      "Enabled": true,
      "MaxStored": 2,
      "DefaultCount": 0
    }
  },
  "DiscoveryScore": {
    "Enabled": true,
    "ScoreVersion": 1,
    "PopularityWeight": 0.20,
    "EngagementWeight": 0.25,
    "QualityWeight": 0.15,
    "MomentumWeight": 0.20,
    "GrowthWeight": 0.10,
    "FreshnessWeight": 0.10,
    "TrendingRecentWeight": 0.30,
    "TrendingMomentumWeight": 0.30,
    "TrendingGrowthWeight": 0.20,
    "TrendingEngagementWeight": 0.15,
    "TrendingFreshnessWeight": 0.05,
    "FreshnessDecayDays": 30,
    "NewGameDays": 14,
    "MinValidSessionsForNewTrending": 3,
    "GrowthSmoothing": 10,
    "BayesianM": 20,
    "RisingGrowthThreshold": 25,
    "DecliningGrowthThreshold": -20,
    "ScoreValidMinutes": 90,
    "CacheTtlMinutes": 10,
    "AggregationIntervalMinutes": 60,
    "RetentionHourlyDays": 90,
    "RetentionDailyDays": 365,
    "RankingLimit": 100
  },
  "AllowedHosts": "*"
}
