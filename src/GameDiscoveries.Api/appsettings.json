{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=gamediscoveries;Username=gamediscoveries;Password=gamediscoveries",
    "ApplyMigrationsOnStartup": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gamediscoveries:",
    "Enabled": true
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": "",
    "Enabled": true
  },
  "GameMonetize": {
    "Enabled": false,
    "BaseUrl": "https://gamemonetize.com",
    "FeedUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "Feeds": {
      "Latest": "",
      "Popular": "",
      "Action": "",
      "Puzzle": "",
      "Racing": "",
      "Sports": "",
      "Multiplayer": "",
      "Mobile": "",
      "TwoPlayer": "",
      "Featured": "",
      "HotGames": "",
      "BestGames": "",
      "MostPlayed": "",
      "ExclusiveGames": ""
    }
  },
  "GameFeedSync": {
    "Enabled": false,
    "AdminApiKey": "",
    "LatestIntervalMinutes": 60,
    "PopularIntervalMinutes": 120,
    "CategoryIntervalMinutes": 360,
    "MobileIntervalMinutes": 360,
    "TwoPlayerIntervalMinutes": 360,
    "FeaturedIntervalMinutes": 360,
    "PopularityIntervalMinutes": 180,
    "StartupDelaySeconds": 20
  },
  "Authentication": {
    "Enabled": true,
    "Authority": "",
    "Issuer": "gamediscoveries-api",
    "Audience": "gamediscoveries-api",
    "SigningKey": "LOCAL_DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+",
    "AccessTokenMinutes": 120,
    "RequireHttpsMetadata": false,
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedDisplayName": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GameDiscoveries.Api",
    "OtlpEndpoint": "",
    "PrometheusEnabled": true
  },
  "RateLimiting": {
    "PublicPermitLimit": 600,
    "SearchPermitLimit": 120,
    "AuthenticationPermitLimit": 30,
    "AnalyticsPermitLimit": 300,
    "WindowSeconds": 60
  },
  "Recommendation": {
    "AlgorithmVersion": "v1",
    "DefaultLimit": 20,
    "CandidateLimit": 150,
    "MaxSameCategoryInTop10": 3,
    "ExplorationRatio": 0.08,
    "Weights": {
      "Content": 0.25,
      "Preference": 0.20,
      "Behavior": 0.20,
      "Popularity": 0.10,
      "Freshness": 0.10,
      "Engagement": 0.05,
      "Exploration": 0.05,
      "Diversity": 0.05
    },
    "ColdStart": {
      "Trending": 0.40,
      "Popular": 0.30,
      "NewDiscoveries": 0.20,
      "Exploration": 0.10
    },
    "CacheTtl": {
      "ForYouSeconds": 600,
      "BecauseYouPlayedSeconds": 600,
      "SimilarSeconds": 1800,
      "TrendingSeconds": 420,
      "NewDiscoveriesSeconds": 1200,
      "HiddenGemsSeconds": 900
    },
    "Exclusion": {
      "ExcludePlayedForYou": true,
      "ExcludeFavoritedForYou": false,
      "ExcludePlayedBecauseYouPlayed": true,
      "ExcludeFavoritedBecauseYouPlayed": false
    }
  },
  "AllowedHosts": "*"
}
