{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=gamediscoveries;Username=gamediscoveries;Password=gamediscoveries",
    "ApplyMigrationsOnStartup": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gamediscoveries:",
    "Enabled": true
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": "",
    "Enabled": true
  },
  "GameMonetize": {
    "Enabled": false,
    "BaseUrl": "https://gamemonetize.com",
    "FeedUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "Feeds": {
      "Latest": "",
      "Popular": "",
      "Action": "",
      "Puzzle": "",
      "Racing": "",
      "Sports": "",
      "Multiplayer": "",
      "Mobile": "",
      "TwoPlayer": "",
      "Featured": ""
    }
  },
  "GameFeedSync": {
    "Enabled": false,
    "AdminApiKey": "",
    "LatestIntervalMinutes": 60,
    "PopularIntervalMinutes": 120,
    "CategoryIntervalMinutes": 360,
    "MobileIntervalMinutes": 360,
    "TwoPlayerIntervalMinutes": 360,
    "FeaturedIntervalMinutes": 360,
    "StartupDelaySeconds": 20
  },
  "Authentication": {
    "Enabled": false,
    "Authority": "",
    "Audience": "gamediscoveries-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GameDiscoveries.Api",
    "OtlpEndpoint": "",
    "PrometheusEnabled": true
  },
  "RateLimiting": {
    "PublicPermitLimit": 60,
    "SearchPermitLimit": 30,
    "AuthenticationPermitLimit": 10,
    "AnalyticsPermitLimit": 120,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*"
}
